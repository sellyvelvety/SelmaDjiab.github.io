  a{color:inherit}
  .container{width:min(calc(100% - 40px),var(--max));margin:auto}
  .topbar{
    background:var(--maroon);
    color:#fff;
    font-size:.82rem;
    letter-spacing:.02em;
  }
  .topbar .container{display:flex;justify-content:flex-end;padding:8px 0}
  .topbar a{text-decoration:none;opacity:.92}
  .topbar a:hover{opacity:1;text-decoration:underline}

  header{
    position:sticky;top:0;z-index:50;
    background:#fff;
    border-bottom:1px solid #e7e7e7;
  }
  .nav{
    min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:20px;
  }
  .brand{text-decoration:none;display:flex;align-items:center;gap:12px}
  .brand-mark{
    width:42px;height:42px;background:var(--maroon);color:#fff;
    display:grid;place-items:center;font-weight:800;font-size:1.05rem;
  }
  .brand-text{font-weight:800;letter-spacing:.02em;font-size:.95rem}
  .brand-text small{display:block;font-weight:400;color:#777;font-size:.68rem;margin-top:-3px}
  nav ul{list-style:none;display:flex;gap:26px;padding:0;margin:0}
  nav a{text-decoration:none;font-size:.9rem;font-weight:700;position:relative;padding:27px 0}
  nav a:after{content:"";position:absolute;left:0;bottom:19px;width:0;height:3px;background:var(--maroon);transition:width .25s}
  nav a:hover:after,nav a.active:after{width:100%}
  .menu{display:none;border:0;background:none;font-size:1.7rem;color:var(--maroon)}

  .hero{
    min-height:calc(100vh - 84px);
    display:grid;align-items:center;
    background:
      linear-gradient(90deg,rgba(122,0,25,.97) 0%,rgba(122,0,25,.92) 53%,rgba(122,0,25,.76) 100%),
      radial-gradient(circle at 82% 20%,#b91e42,transparent 28%),
      #7a0019;
    color:#fff;
    position:relative;overflow:hidden;
  }
  .hero:before,.hero:after{
    content:"";position:absolute;border:1px solid rgba(255,255,255,.14);
    transform:rotate(45deg);pointer-events:none;
  }
  .hero:before{width:280px;height:280px;right:-90px;top:-80px}
  .hero:after{width:430px;height:430px;right:70px;bottom:-280px}
  .hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:60px;align-items:center;padding:88px 0}
  .eyebrow{
    display:inline-flex;align-items:center;gap:10px;font-weight:700;
    text-transform:uppercase;letter-spacing:.13em;font-size:.76rem;margin-bottom:22px;
  }
  .eyebrow:before{content:"";width:34px;height:3px;background:#fff}
  h1{
    font-family:Georgia,"Times New Roman",serif;
    font-size:clamp(3.1rem,7vw,6.5rem);line-height:.94;
    margin:0 0 26px;font-weight:700;letter-spacing:-.045em;
  }
  .hero-role{font-size:clamp(1.15rem,2vw,1.55rem);font-weight:700;margin:0 0 16px}
  .hero-pitch{font-size:1.05rem;max-width:650px;color:rgba(255,255,255,.86);margin:0 0 34px}
  .buttons{display:flex;flex-wrap:wrap;gap:12px}
  .btn{
    display:inline-block;padding:13px 21px;text-decoration:none;font-weight:800;
    border:2px solid #fff;transition:.25s ease;
  }
  .btn.primary{background:#fff;color:var(--maroon)}
  .btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.14)}
  .hero-side{border-left:1px solid rgba(255,255,255,.35);padding-left:34px}
  .hero-side .number{font-family:Georgia,serif;font-size:5rem;line-height:1;font-weight:700}
  .hero-side p{margin:8px 0 28px;color:rgba(255,255,255,.78)}

  section{padding:92px 0}
  section:nth-of-type(even){background:var(--offwhite)}
  .section-head{display:grid;grid-template-columns:240px 1fr;gap:40px;margin-bottom:48px}
  .section-label{
    color:var(--maroon);font-size:.76rem;font-weight:800;text-transform:uppercase;
    letter-spacing:.14em;padding-top:8px;
  }
