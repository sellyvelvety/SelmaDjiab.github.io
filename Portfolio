  .contact .section-head p{color:rgba(255,255,255,.8)}
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
  .contact h2{font-family:Georgia,serif;font-size:clamp(2.5rem,5vw,4.4rem);line-height:1;margin:0}
  .contact-links{border-top:1px solid rgba(255,255,255,.35)}
