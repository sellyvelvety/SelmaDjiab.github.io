  .contact-link:hover{text-decoration:underline}
  footer{background:#47000f;color:#fff;padding:24px 0;font-size:.78rem}
  footer .container{display:flex;justify-content:space-between;gap:20px}

  .reveal{opacity:0;transform:translateY(18px);transition:opacity .65s ease,transform .65s ease}
  .reveal.visible{opacity:1;transform:none}

  @media(max-width:800px){
    .container{width:min(calc(100% - 28px),var(--max))}
    .topbar{display:none}
    .nav{min-height:66px}
    nav{display:none;position:absolute;top:66px;left:0;right:0;background:#fff;border-bottom:1px solid #ddd}
