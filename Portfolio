  .job ul{margin:0;padding-left:18px;color:#444}

  .projects{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
  .project{
    background:#fff;border:1px solid var(--line);padding:30px;
    position:relative;overflow:hidden;transition:.3s ease;
  }
  .project:before{content:"";position:absolute;left:0;top:0;width:5px;height:0;background:var(--maroon);transition:.3s}
  .project:hover{transform:translateY(-5px);box-shadow:0 14px 35px rgba(0,0,0,.08)}
  .project:hover:before{height:100%}
  .project .tag{display:inline-block;color:var(--maroon);font-size:.73rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:14px}
  .project p{color:var(--muted);margin:0}
  .tech{margin-top:18px;font-size:.82rem;font-weight:700;color:#444}

  .skills-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .skill-group{padding:25px;background:#fff;border:1px solid var(--line)}
  .skill-group h3{margin:0 0 12px;font-size:1rem;color:var(--maroon)}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{border:1px solid #ccc;padding:6px 10px;font-size:.8rem;background:#fafafa}

  .contact{background:var(--maroon)!important;color:#fff}
